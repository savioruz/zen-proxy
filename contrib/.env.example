# Port exposed on host machine
PORT=8787

# Optional: Preconfigure OpenCode Zen API key
# ZEN_KEY=

# Optional: Set an auth key required for clients connecting to zen-proxy
# PROXY_KEY=

# Optional: Override upstream endpoint (default is OpenCode Zen API)
# UPSTREAM=https://opencode.ai/zen/v1

# Optional: Outbound proxy pool for upstream requests (ala 9router)
# PROXY_POOL=http://user:pass@proxy1:8080,http://proxy2:8080
# PROXY_STRATEGY=round-robin
